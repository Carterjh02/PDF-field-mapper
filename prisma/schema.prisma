// ============================================================
// PDF FIELD MAPPER — DATABASE SCHEMA
// ============================================================
// Separate Supabase PostgreSQL project for mapper metadata.
// The actual approved PDF key names come from fillPdf.ts and
// will be inserted as rows in DictionaryKey (not as columns).
// PDF files and customer/job values are not stored here.
//
// Prisma 7 reads DATABASE_URL from prisma.config.ts.
// The desktop application will use Supabase Auth + RLS for
// ordinary queries; never ship a database connection string.
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FieldCategory {
  CUSTOMER
  COMPANY
  JOB_PROPERTY
  GENERIC
}

enum MappingSource {
  EXACT_MATCH
  PAGE_TEMPLATE
  GLOBAL_ALIAS
  NORMALIZED_MATCH
  FUZZY_MATCH
  NEARBY_TEXT
  OCR
  MANUAL
}

enum MappingScope {
  GLOBAL
  PAGE_TEMPLATE
}

// Approved PDF names, e.g. customer_name, company_license,
// mech_license_number, desc_of_improv, and customer_tax_folio20.
// Canonical keys should be deactivated rather than deleted.
model DictionaryKey {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  keyName          String        @unique @map("key_name")
  displayName      String        @map("display_name")
  category         FieldCategory
  description      String?
  websiteSupported Boolean?      @map("website_supported")
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at")

  aliases        FieldAlias[]
  templateFields PageTemplateField[]
  confirmations  MappingConfirmation[]

  @@index([category])
  @@index([isActive])
  @@map("dictionary_keys")
}

// Confirmed GLOBAL alternative names only. Context-dependent
// names such as Text17 belong in PageTemplateField instead.
model FieldAlias {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  originalName   String   @map("original_name")
  normalizedName String   @unique @map("normalized_name")
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  dictionaryKeyId String        @map("dictionary_key_id") @db.Uuid
  dictionaryKey   DictionaryKey @relation(fields: [dictionaryKeyId], references: [id], onDelete: Restrict)

  @@index([dictionaryKeyId])
  @@index([isActive])
  @@map("field_aliases")
}

// A page-level layout, not necessarily an entire PDF file.
// Fingerprints and their algorithm version will be determined
// when implementing real PDF page recognition.
model PageTemplate {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateName       String   @map("template_name")
  documentName       String?  @map("document_name")
  pageNumber         Int?     @map("page_number")
  fingerprint        String
  fingerprintVersion Int      @default(1) @map("fingerprint_version")
  pageWidth          Float    @map("page_width")
  pageHeight         Float    @map("page_height")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  fields        PageTemplateField[]
  confirmations MappingConfirmation[]

  @@unique([fingerprint, fingerprintVersion])
  @@index([isActive])
  @@map("page_templates")
}

// Maps PDF field names to approved keys in one recognized page.
// Widget index allows recording multiple appearances of a
// logical field; the editor must prevent conflicting mappings
// across widgets that share the same AcroForm field name.
model PageTemplateField {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  originalFieldName String   @map("original_field_name")
  widgetIndex       Int      @default(0) @map("widget_index")
  fieldType         String?  @map("field_type")
  x                 Float?
  y                 Float?
  width             Float?
  height            Float?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  pageTemplateId String       @map("page_template_id") @db.Uuid
  pageTemplate   PageTemplate @relation(fields: [pageTemplateId], references: [id], onDelete: Cascade)

  dictionaryKeyId String        @map("dictionary_key_id") @db.Uuid
  dictionaryKey   DictionaryKey @relation(fields: [dictionaryKeyId], references: [id], onDelete: Restrict)

  @@unique([pageTemplateId, originalFieldName, widgetIndex])
  @@index([dictionaryKeyId])
  @@map("page_template_fields")
}

// Audit record created only AFTER a PDF copy is successfully
// saved locally. savedOutputId correlates events; it does NOT
// itself prove a filesystem write succeeded.
// A confirmation does not automatically create a global alias.
model MappingConfirmation {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  originalFieldName String        @map("original_field_name")
  source            MappingSource
  scope             MappingScope
  notes             String?
  savedOutputId     String        @map("saved_output_id") @db.Uuid
  confirmedAt       DateTime      @default(now()) @map("confirmed_at")

  dictionaryKeyId String        @map("dictionary_key_id") @db.Uuid
  dictionaryKey   DictionaryKey @relation(fields: [dictionaryKeyId], references: [id], onDelete: Restrict)

  // Required by application logic when scope = PAGE_TEMPLATE.
  // Add a database-level conditional CHECK in the SQL migration.
  pageTemplateId String?       @map("page_template_id") @db.Uuid
  pageTemplate   PageTemplate? @relation(fields: [pageTemplateId], references: [id], onDelete: Restrict)

  @@index([dictionaryKeyId])
  @@index([pageTemplateId])
  @@index([savedOutputId])
  @@index([confirmedAt])
  @@map("mapping_confirmations")
}

// ============================================================
// APPLICATION ADMINISTRATORS
// ============================================================
//
// Stores Supabase Auth user IDs authorized to manage
// the PDF Field Mapper database.
//
// Administrator records are managed through trusted
// database operations, not public application registration.
//
// No passwords or authentication credentials are stored here.

model AdminUser {
  userId    String   @id @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}
